{
  "manifest_version": 3,
  "name": "Busistree - WhatsApp Order & Status Bot",
  "version": "1.1.0",
  "description": "WooCommerce order notifications and opt-in verified WhatsApp chat assistance for product discovery and confirmed orders.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://web.whatsapp.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "chatbot-engine.js",
        "whatsapp-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Busistree WhatsApp Bot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
